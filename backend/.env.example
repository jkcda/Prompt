# ============================================================
# 视频提示词反推 · 后端配置
# 复制本文件为 .env 后填写。所有项都有默认值，最小可用只需填 VLM_API_KEY
# ============================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端地址，逗号分隔；* 表示全部放开
CORS_ORIGINS=*
# 开发模式（fastapi dev 时自动开启热重载与 DEBUG 日志）
DEBUG=false

# ---------- 持久化 ----------
# SQLite 单文件。相对路径按 data/ 解析，也可写绝对路径
DATABASE_URL=sqlite:///app.db
# 任务历史保留天数（0 = 永久保留）
HISTORY_KEEP_DAYS=30

# ---------- 多模态模型（反推核心） ----------
# 兼容 OpenAI 格式的任意服务：ModelScope / 阿里云百炼 / 火山方舟 / OpenRouter / 本地 vLLM
VLM_API_KEY=
VLM_BASE_URL=https://api-inference.modelscope.cn/v1
# 必须是支持视觉输入的模型
VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
VLM_TIMEOUT=180
# 并发请求数（Pass1 逐块并行分析）
VLM_CONCURRENCY=3
# 把音频片段直接附给模型（OpenAI 的 input_audio 内容块）。默认关。
# ⚠ 能收音频的模型很少 —— 很多「多模态」模型只支持图片，不支持音频。
#   开了但模型不支持会返回 choices:null（代码会明确报出来，不会含糊）。
#   只在没有 ASR 转写时才附；已经有转写文本就没必要再送音频。
#   2026-09 实测：ModelScope 上 Qwen3.5-27B 不支持音频，
#   Qwen3-Omni / Qwen2-Audio 系列在该账号下无可用推理服务。
VLM_AUDIO_INPUT=false
# 单次回复的 token 上限。**推理模型必须给大** ——
# DeepSeek-V4.x 的思考过程可达 5 万字符，6144 会被思考吃光、正文一个字写不出来
# （finish_reason=length、content 为空），看起来像「不支持图片」，其实只是预算不够。
# 实测 6 张图约需 16384。这只是上限，非推理模型提前结束不会多花钱。
VLM_MAX_TOKENS=16384
# 关掉推理模型的思考过程（DeepSeek-V4.x / Qwen3 这类）。
# 实测 DeepSeek-V4.1-Flash：开着 88s 且正文被思考挤空；关掉 9.9s 且正文正常。
# 反推要的是「照结构填内容」，不是解题，思考过程基本是浪费。
# 不支持的模型会自动摘掉这个参数重试，所以默认开着是安全的。
VLM_DISABLE_THINKING=true
# 最终提示词的**整篇**词数上限（含 subject_definitions / retention_analysis，不只是正文）。
# 视频生成模型的提示词窗口有限，超长会被截断或忽略。
# 不限长时六段式很容易写到 1800 词 / 11000 字符 —— 视频模型吃不下。
PROMPT_WORD_LIMIT=700

# ---------- 语音转写 ----------
#
# **推荐走线上 API**：免费额度就够用（下面两个例子），
# 不用下 460MB 权重、也不用占 1.2GB 内存。
# 留空则跳过语音转写 —— 有台词/唱歌的视频会缺一整个维度（歌词字段只能写 N/A）。
#
# 例子一：硅基流动（国内可直连，`SenseVoiceSmall` / `TeleSpeechASR` 标为免费）
#   ⚠️ 域名是 .cn，旧的英文文档写的 .com 会把正确的 Key 打成 401
#   ASR_BASE_URL=https://api.siliconflow.cn/v1
#   ASR_MODEL=FunAudioLLM/SenseVoiceSmall
#
# 例子二：Groq（`whisper-large-v3-turbo`，Free Plan 2000 次/日）
#   ASR_BASE_URL=https://api.groq.com/openai/v1
#   ASR_MODEL=whisper-large-v3-turbo
#
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1

# ---- 本地 whisper（可选兜底，默认不用）----
# 只有「装了 faster-whisper 且没配上面的 ASR_*」时才会走到。
# 规格按内存选（int8 推理峰值，含模型常驻）：
#   base  → 145MB / ~350MB   4 核 4G 求稳
#   small → 480MB / ~1.2GB   默认，准确率与内存的平衡点
ASR_WHISPER_MODEL=small
# 模型目录。留空自动找 backend/vendor/whisper/<规格>/，
# 再找不到才按规格名去 HuggingFace 下载。见 scripts/fetch-whisper-model.py
ASR_MODEL_PATH=
# whisper 用几个线程。0 = 自动（min(4, CPU 核数)）。4 核机器填 2 更划算。
ASR_CPU_THREADS=0
# 权重下载源。留空用 https://hf-mirror.com；海外部署写 https://huggingface.co
ASR_HF_ENDPOINT=

# ---------- ffmpeg ----------
# 留空即可 —— 项目自带 backend/vendor/ffmpeg/ffmpeg.exe，会自动优先用它，
# 部署时不用在服务器上另装 ffmpeg。
# 查找顺序：FFMPEG_PATH > FFMPEG_DIR > vendor/ffmpeg > runtime > 系统 PATH > 常见安装位置
# 只有想用别的版本时才需要显式指定。
FFMPEG_PATH=
# 若指定目录，则从该目录找 ffmpeg / ffprobe
FFMPEG_DIR=

# ---------- 抽帧预算（反推质量的关键旋钮） ----------
# 真正决定抽多少帧的是下面两条，MAX_TOTAL_FRAMES 只是安全网。
# 每个镜头取几帧 = clamp(镜头时长 / FRAME_INTERVAL_SECONDS, 1, MAX_FRAMES_PER_SHOT)
# 例：15 秒 / 4 个镜头 -> 每镜 3~5 帧，合计约 15 帧
#
# 单次请求的总帧数上限（安全网）。15 秒的短片只会用到 15 帧左右，
# 给大不影响短片，只保证长视频不失控。
# 实测一帧约 284 tokens（长边 896px）。96 帧 ≈ 2.7 万，1000 帧 ≈ 28 万。
# 帧数几乎不可能是瓶颈 —— 真正的限制是延迟和收益递减。
# 128k 上下文用 96 绰绰有余；1M 上下文可以到 1000。
MAX_TOTAL_FRAMES=96
# 单个镜头的帧数上限。**硬上限**，设小就真的少给。
# 默认 24（原来 8）：原来 8 会把「一镜到底」的视频卡死 ——
# 15 秒的连续镜头只抽 8 帧（一帧管 1.9 秒），60 秒的也只有 8 帧（一帧管 7.5 秒），
# 而预算还剩一大半没用。24 让 15 秒的连续镜头给满 15 帧（一秒一帧），
# 4 镜头的常规视频行为不变。想让 60 秒单镜也一秒一帧就调到 60。
# 要限制**总**帧数请用 MAX_TOTAL_FRAMES。
MAX_FRAMES_PER_SHOT=24
# 镜头内平均多久取一帧。0.5 = 每秒两帧
# 一秒一帧对快速动作/特效内容偏疏 —— 半秒内发生的变化会被整段漏掉，
# 模型看不到就只能编。一帧约 284 tokens，密度翻倍的成本可以接受。
FRAME_INTERVAL_SECONDS=0.5
# 单个镜头超过多少秒时额外补帧
LONG_SHOT_SECONDS=5.0
# ---------- 拼图模式（contact sheet）----------
# 把帧拼成网格图再送给模型。0 = 关闭（每帧单独一张图）。
#
# 为什么值得开：实测模型对图片 token 有上限 —— 网格从 2.7Mpx 做到 9.2Mpx（3.4 倍），
# token 只从 1156 涨到 1176。**一格里放 6 帧还是 20 帧，成本几乎一样。**
# 所以同预算下能换到几倍的时间覆盖度，而且更快。
#
# 实测（13.3s 视频，Pass1 全流程）：
#   1fps / 12 张单帧 -> 46s，画面要素 7/7，镜头数 12（每帧一个，过碎）
#   2fps / 3 张 3x3  -> 26s，画面要素 7/7，镜头数 5（更接近真实的 4）
#
# ⚠️ 代价是小字：6 格时文字可靠，9 格以上开始编
# （实测 9/12/16/20 格都把 FUTURE HERO 读成 ULTRA HERO，偶尔又能读对 ——
# 在临界点上随机翻）。画面描述不受影响。
#   只关心画面 -> 9~12；需要读小字 -> 4~6；要绝对可靠 -> 保持 0 用单帧。
FRAME_SHEET_CELLS=0
# 拼图模式下每秒抽几帧。2.0 = 一秒两帧，配 9 格约每 4.5 秒一张图
FRAME_SAMPLE_FPS=2.0
# 送给模型的图片长边像素（再高对反推无收益，纯烧 token）
FRAME_LONG_EDGE=896
# JPEG 质量
FRAME_JPEG_QUALITY=82

# ---------- 镜头分割 ----------
# 场景切换阈值 0~1，越小越敏感。访谈/口播类用 0.35，快剪类用 0.25
SCENE_THRESHOLD=0.30
# 最短镜头时长（秒），低于此值不单独成镜头，避免快闪噪声
MIN_SHOT_SECONDS=0.8

# ---------- 反推质量管线（v2） ----------
#
# 这四项是针对实测出来的四个质量缺陷做的修补，每一项都能单独关掉 ——
# 如果改完质量反而变差，可以逐项关掉定位是哪一步的锅。
# 关掉任何一项都会退回旧行为。

# 1) 客观运动分析：ffmpeg 抽灰度小图 + 纯 Python 光流，算出每个镜头的位移
#    方向和速度，作为**数据**喂给模型。
#
#    ⚠️ **默认关**（2026-09-24 实测对照）：同一段素材，开与不开，
#    camera 字段的结论完全一样，但开着的端到端耗时是 136s vs 51s。
#    默认抽帧密度是 2fps（每镜多帧），模型自己就能从帧图判断运镜 ——
#    这一层只在「帧数被压得很低」时才有价值（早期每镜 1~3 帧时，
#    38 个镜头全被标成 static）。
#    想开就改成 true。
MOTION_ANALYSIS=false

# 2) 相邻镜头合并：把「同一个机位被模型拆成好几条」的复读条目合并成一个。
#    实测出现过 23 条交替的「三人跳舞」/「三人继续」，全是同一个机位。
#    提示词里写明规则也治不住，所以代码侧兜底。
MERGE_ADJACENT_SHOTS=true

# 3) 特写镜头的画面外属性清理。实测 `Extreme close-up` 的描述里出现了
#    `white socks, black ankle boots` —— 特写根本看不到袜子。
STRICT_FRAME_VISIBILITY=true

# 4) 转写前做人声频段分离。MV / 现场录音里鼓和贝斯能量很强，whisper 会被伴奏
#    带偏；带通滤掉 180Hz 以下和 4kHz 以上之后，歌词准确率明显更高。
#    装了 Demucs 会自动优先用它（更准，但要 torch）。
VOCAL_ISOLATION=true

# ---------- 长视频分块 ----------
# 超过多少秒触发分块分析
CHUNK_THRESHOLD_SECONDS=90
# 每块目标时长（秒）
CHUNK_SECONDS=60
# 块间重叠（秒），防止把一个镜头劈断丢信息
CHUNK_OVERLAP_SECONDS=2.0
# 超长视频直接截断的时长（秒），0 表示不限制
MAX_DURATION_SECONDS=1800

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=500

# ---------- 抓取 ----------
# B站/抖音下载的 cookie（可选）。B站大会员内容、抖音部分视频需要
# 格式：浏览器名，如 chrome / edge / firefox（从本机浏览器读取 cookie）
COOKIES_FROM_BROWSER=
# 或直接给 Netscape 格式的 cookies.txt 路径
COOKIES_FILE=
# 下载清晰度上限（透传给 yt-dlp 的 -f）。反推会把帧缩到长边 FRAME_LONG_EDGE 再送模型，
# 所以下 1080p 是纯浪费带宽和等待时间，默认封顶 720p。
# 想强制原画质就写 bv*+ba/b
YTDLP_FORMAT=bv*[height<=720][ext=mp4]+ba[ext=m4a]/bv*[height<=720]+ba/b[height<=720]/bv*+ba/b
