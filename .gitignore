# ---------------- 运行时数据 ----------------
# 上传的视频、抽帧图片、临时文件、SQLite 数据库
data/
!data/.gitkeep
backend/runtime/

# 提示词导出（用 python -m app.dump_prompts 随时重新生成）
prompts-dump/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---------------- 第三方二进制与模型 ----------------
# ffmpeg 体积可控（两个平台共 156MB），进仓库是为了部署可复现。
# 但语音转写的模型权重单个 460MB，**会被远端仓库的大文件限制直接拒掉**，
# 所以不进 git。它放在 backend/vendor/whisper/ 下，打包 / rsync / docker COPY
# 会照常带上；纯 git 部署的话在服务器上跑一次 scripts/fetch-whisper-model.py。
backend/vendor/whisper/

# ---------------- Node / 前端 ----------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/auto-imports.d.ts
frontend/components.d.ts
*.local
.vite/

